---
import '../styles/global.css';
const focusStyles = `<style>html{overflow-x:clip}body{overflow-x:clip}.button-primary:focus-visible,.button-secondary:focus-visible,.faq-button:focus-visible{outline:2px solid var(--violet-bright);outline-offset:4px}.button-primary:active,.button-secondary:active,.faq-button:active{transform:scale(.98)}.button-primary:disabled,.button-secondary:disabled{opacity:.55;cursor:not-allowed}</style>`;
const faqs=[['Already comply in my head.','Proof on paper. When WRC or staff ask, the roster shows the 11h gaps and breaks were planned.'],["We're too small.",'Built for 5–20 staff. No enterprise HR bloat.'],['No time to set up.',"Team in once. Next week's roster in minutes — or cancel."],['Another rota app?','Excel draws the grid. We draw the grid and enforce Irish working time rules.'],['Is the monthly fee worth it?','Less than one hour of manager time fixing Excel each week. Starter from €20/month.']];
const plans=[
  {name:'Starter',price:'€20',unit:'/ month',detail:'Up to 10 staff',trial:'15-day free trial',cta:'Start 15-day free trial',href:'mailto:hello@madfrog.ie?subject=Escala%20Starter%20trial',featured:false,selfServe:true},
  {name:'Standard',price:'€35',unit:'/ month',detail:'Up to 20 staff',trial:'15-day free trial',cta:'Start 15-day free trial',href:'mailto:hello@madfrog.ie?subject=Escala%20Standard%20trial',featured:true,selfServe:true},
  {name:'Plus',price:'€55',unit:'/ month',detail:'Up to 35 staff',trial:'15-day free trial',cta:'Start 15-day free trial',href:'mailto:hello@madfrog.ie?subject=Escala%20Plus%20trial',featured:false,selfServe:true},
  {name:'Network',price:'€40',unit:'/ location / mo',detail:'3+ locations',trial:'Talk to us',cta:'Talk to us',href:'mailto:hello@madfrog.ie?subject=Escala%20Network',featured:false,selfServe:false},
];
---
<html lang="en" data-type="software" data-site-kind="software"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Escala builds café rosters in minutes. Stay on the right side of Irish law. From €20/month. 15-day free trial. No card required." /><title>Escala — café rosters done in minutes</title></head><body>
<header class="relative z-10"><nav class="container-shell flex items-center justify-between py-6" aria-label="Main navigation"><a href="#top" class="text-xl font-bold tracking-tight flex items-center gap-2">escala<svg width="18" height="20" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polygon points="24,4 41.32,14 41.32,34 24,44 6.68,34 6.68,14" fill="rgba(139,92,246,0.18)" stroke="#a78bfa" stroke-width="2.5" stroke-linejoin="round"/><polygon points="24,12 34.39,18 34.39,30 24,36 13.61,30 13.61,18" fill="none" stroke="rgba(167,139,250,0.45)" stroke-width="1" stroke-linejoin="round"/></svg></a><a href="#pricing" class="button-secondary !min-h-10 !px-4 text-sm">Start 15-day free trial</a></nav></header>
<main id="top">
<section class="relative isolate overflow-hidden pt-16 pb-24 md:pt-28 md:pb-32"><div class="hero-grid absolute inset-0 -z-10"></div><div class="hero-glow -z-10"></div><div class="container-shell grid items-center gap-14 lg:grid-cols-[1.02fr_.98fr]"><div class="reveal"><p class="eyebrow mb-6">Dublin cafés · 5–20 staff</p><h1 class="display-head text-5xl font-semibold md:text-7xl">Your roster done in minutes!</h1><p class="mt-7 max-w-xl text-lg leading-8 muted">Your cafe roster, done in clicks. Save hours every week — and stay on the right side of Irish law.</p><div class="mt-9 flex flex-col gap-3 sm:flex-row"><a class="button-primary" href="#pricing">Start 15-day free trial <span aria-hidden="true">↗</span></a><a class="button-secondary" href="#sample-week">See a sample Dublin week</a></div><p class="mt-4 max-w-lg text-sm leading-6 muted">15-day free trial. No card required to start.</p></div><div id="sample-week" class="reveal hero-panel rounded-[22px] p-5 md:p-6"><div class="flex items-center justify-between border-b border-white/10 pb-4"><div><p class="mono text-xs text-violet-300">The Copper Kettle · week 42 · dublin 8</p><h2 class="mt-1.5 text-base font-semibold leading-tight">14–20 Oct · 5 staff · all legal</h2></div><span class="rounded-full bg-emerald-300/10 px-3 py-1 text-xs text-emerald-200">WRC-safe</span></div><div class="roster-wrap mt-3"><table class="roster-tbl"><thead><tr><th></th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th><th>Sun</th></tr></thead><tbody><tr><td class="staff-name">Aoife</td><td class="shift-open">Open<br/>08–16</td><td class="shift-open">Open<br/>08–16</td><td class="shift-off">—</td><td class="shift-open">Open<br/>08–16</td><td class="shift-open">Open<br/>08–16</td><td class="shift-off">—</td><td class="shift-close">Close<br/>14–22</td></tr><tr><td class="staff-name">Sam</td><td class="shift-off">—</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-off">—</td><td class="shift-close">Close<br/>14–22</td><td class="shift-off">—</td></tr><tr><td class="staff-name">Niamh</td><td class="shift-open">Open<br/>08–16</td><td class="shift-off">—</td><td class="shift-open">Open<br/>08–16</td><td class="shift-off">—</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-open">Open<br/>08–16</td></tr><tr><td class="staff-name">Ciarán</td><td class="shift-off">—</td><td class="shift-close">Close<br/>14–22</td><td class="shift-off">—</td><td class="shift-close">Close<br/>14–22</td><td class="shift-off">—</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-mid">Mid<br/>11–19</td></tr><tr><td class="staff-name">Roisín</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-off">—</td><td class="shift-close">Close<br/>14–22</td><td class="shift-off">—</td><td class="shift-close">Close<br/>14–22</td><td class="shift-open">Open<br/>08–16</td><td class="shift-off">—</td></tr></tbody></table></div><div class="mt-3 flex items-center justify-between text-xs muted border-t border-white/10 pt-3"><span>Generated in 8 seconds · 0 violations</span><span class="mono text-violet-300">export.pdf</span></div></div></div></section>
<section class="section section-rule py-12 md:py-16"><div class="container-shell grid gap-8 md:grid-cols-3"><div class="problem-item reveal"><span class="problem-icon">↗</span><div><h2 class="font-semibold">Clopening blocked automatically</h2><p class="mt-2 text-sm muted">No close-then-open surprises.</p></div></div><div class="problem-item reveal"><span class="problem-icon">◷</span><div><h2 class="font-semibold">11-hour rest enforced</h2><p class="mt-2 text-sm muted">Every gap checked before you post.</p></div></div><div class="problem-item reveal"><span class="problem-icon">◆</span><div><h2 class="font-semibold">Keyholder on every close</h2><p class="mt-2 text-sm muted">The right person is always there.</p></div></div></div></section>
<section class="section section-rule"><div class="container-shell"><div class="grid gap-8 md:grid-cols-[.8fr_1.2fr] md:items-end"><h2 class="display-head text-4xl font-semibold md:text-5xl reveal">Excel draws the grid. Escala checks the week.</h2><p class="max-w-lg leading-7 muted reveal">The difference is not another rota template. It is knowing the schedule is ready before it reaches the staff WhatsApp.</p></div><div class="comparison mt-14 reveal"><div class="comparison-row comparison-head"><div>Excel</div><div class="text-violet-300">Escala</div></div><div class="comparison-row"><div class="muted">Manual</div><div>Automatic</div></div><div class="comparison-row"><div class="muted">Error-prone</div><div>Legal &amp; compliant</div></div><div class="comparison-row"><div class="muted">No compliance check</div><div>Generates in minutes</div></div><div class="comparison-row"><div class="muted">Sunday nightmare</div><div>Legally defensible</div></div></div></div></section>
<section id="how-it-works" class="section section-rule"><div class="container-shell"><h2 class="display-head text-4xl font-semibold md:text-5xl reveal">From team list to posted roster.</h2><div class="mt-14 grid gap-px overflow-hidden rounded-[18px] border border-white/10 bg-white/10 md:grid-cols-3"><div class="bg-[var(--surface)] p-7 reveal"><p class="mono text-sm text-violet-300">01</p><h3 class="mt-12 text-2xl font-semibold">Add your team</h3><p class="mt-4 muted">Five minutes to set availability, roles, and keyholders.</p></div><div class="bg-[var(--surface)] p-7 reveal"><p class="mono text-sm text-violet-300">02</p><h3 class="mt-12 text-2xl font-semibold">Generate the week</h3><p class="mt-4 muted">Ten seconds to solve the shifts without gaps.</p></div><div class="bg-[var(--surface)] p-7 reveal"><p class="mono text-sm text-violet-300">03</p><h3 class="mt-12 text-2xl font-semibold">Export and post</h3><p class="mt-4 muted">Post a clean PDF or send the CSV to your team.</p></div></div></div></section>
<section class="section section-rule"><div class="container-shell"><div class="grid gap-4 md:grid-cols-3"><article class="feature-card reveal"><p class="mono text-sm text-violet-300">01</p><h2 class="mt-16 text-2xl font-semibold">11h rest and breaks, enforced</h2><p class="mt-4 leading-7 muted">Clopening blocked. Breaks scheduled. Keyholder on every close.</p></article><article class="feature-card reveal"><p class="mono text-sm text-violet-300">02</p><h2 class="mt-16 text-2xl font-semibold">Sunday night, reclaimed</h2><p class="mt-4 leading-7 muted">Team once. Legal week in minutes. Export and post.</p></article><article class="feature-card reveal"><p class="mono text-sm text-violet-300">03</p><h2 class="mt-16 text-2xl font-semibold">Café-simple, not HR-complex</h2><p class="mt-4 leading-7 muted">For owners and floor managers. No training course.</p></article></div></div></section>
<section id="pricing" class="section section-rule"><div class="container-shell"><div class="reveal max-w-2xl"><h2 class="display-head text-4xl font-semibold md:text-5xl">Plans that fit your café.</h2><p class="mt-6 text-lg leading-8 muted">15-day free trial on Starter, Standard, and Plus. No card required to start.</p></div><div class="price-grid mt-14">{plans.map((plan)=>(
          <article class:list={['price-card','reveal','p-6','md:p-7', plan.featured && 'price-card--featured']}>
            <p class="mono text-xs text-violet-300">{plan.name}{plan.featured ? ' · most cafés' : ''}</p>
            <p class="mt-4 text-4xl font-semibold">{plan.price}<span class="text-base font-normal muted">{plan.unit}</span></p>
            <p class="mt-3 text-sm muted">{plan.detail}</p>
            <p class="mt-2 text-sm">{plan.trial}</p>
            <a class:list={[plan.selfServe ? 'button-primary' : 'button-secondary', 'mt-8', 'w-full']} href={plan.href}>{plan.cta}{plan.selfServe ? <span aria-hidden="true"> ↗</span> : null}</a>
            <p class="mt-4 text-center text-xs muted">No setup fee. Cancel anytime.</p>
          </article>
        ))}</div></div></section>
<section class="section section-rule"><div class="container-shell grid gap-12 md:grid-cols-[.75fr_1.25fr]"><h2 class="display-head text-4xl font-semibold md:text-5xl reveal">Questions owners ask on Sunday night.</h2><div class="reveal">{faqs.map(([question,answer])=><div class="faq-item" data-open="false"><button class="faq-button" type="button" aria-expanded="false"><span>{question}</span><span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-answer"><div><p class="pb-5 pr-8 leading-7 muted">{answer}</p></div></div></div>)}</div></div></section>
</main><footer class="section section-rule !pb-10"><div class="container-shell flex flex-col gap-8 md:flex-row md:items-end md:justify-between"><div><a href="#top" class="text-xl font-bold tracking-tight flex items-center gap-2">escala<svg width="18" height="20" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polygon points="24,4 41.32,14 41.32,34 24,44 6.68,34 6.68,14" fill="rgba(139,92,246,0.18)" stroke="#a78bfa" stroke-width="2.5" stroke-linejoin="round"/><polygon points="24,12 34.39,18 34.39,30 24,36 13.61,30 13.61,18" fill="none" stroke="rgba(167,139,250,0.45)" stroke-width="1" stroke-linejoin="round"/></svg></a><p class="mt-4 text-sm muted">Built in Dublin by Mad Frog Studio · <a class="underline decoration-white/20 underline-offset-4" href="https://madfrog.ie">madfrog.ie</a></p></div><div class="text-sm md:text-right"><a class="underline decoration-white/20 underline-offset-4" href="mailto:hello@madfrog.ie">hello@madfrog.ie</a><p class="mt-3 text-xs muted">© 2026 Mad Frog Studio</p></div></div></footer>
<script>
import { animate, inView } from 'motion';
document.querySelectorAll('.reveal').forEach((el,i)=>inView(el,()=>animate(el,{opacity:[0,1],transform:['translateY(20px)','translateY(0)']},{duration:.65,delay:Math.min(i*.04,.22),easing:[.22,1,.36,1]})));
document.querySelectorAll('.faq-button').forEach(button=>button.addEventListener('click',()=>{const item=button.closest('.faq-item');const open=item.dataset.open==='true';document.querySelectorAll('.faq-item').forEach(other=>{other.dataset.open='false';other.querySelector('.faq-button').setAttribute('aria-expanded','false')});item.dataset.open=String(!open);button.setAttribute('aria-expanded',String(!open));}));
</script></body></html>
