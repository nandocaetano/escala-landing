---
import '../styles/global.css';
const focusStyles = `<style>html{overflow-x:clip}body{overflow-x:clip}.button-primary:focus-visible,.button-secondary:focus-visible,.faq-button:focus-visible{outline:2px solid var(--violet-bright);outline-offset:4px}.button-primary:active,.button-secondary:active,.faq-button:active{transform:scale(.98)}.button-primary:disabled,.button-secondary:disabled{opacity:.55;cursor:not-allowed}</style>`;
const faqs=[['Already comply in my head.','Proof on paper. When WRC or staff ask, the roster shows the 11h gaps and breaks were planned.'],["We're too small.",'Built for 5–20 staff. No enterprise HR bloat.'],['No time to set up.',"Team in once. Next week's roster in minutes — or cancel."],['Another rota app?','Excel draws the grid. We draw the grid and enforce Irish working time rules.'],['Is the monthly fee worth it?','Less than one hour of manager time fixing Excel each week. Starter from €20/month.']];
const plans=[
  {name:'Starter',tier:'starter',detail:'Up to 10 staff',featured:false,selfServe:true,monthly:{price:'€19',unit:'/ month'},annual:{price:'€159',unit:'/ year',save:'Save €69'}},
  {name:'Standard',tier:'standard',detail:'Up to 20 staff',featured:true,selfServe:true,monthly:{price:'€39',unit:'/ month'},annual:{price:'€329',unit:'/ year',save:'Save €139'}},
  {name:'Pro',tier:'plus',detail:'Up to 40 staff',featured:false,selfServe:true,monthly:{price:'€65',unit:'/ month'},annual:{price:'€549',unit:'/ year',save:'Save €231'}},
  {name:'Network',detail:'2+ locations',featured:false,selfServe:false,href:'mailto:hello@madfrog.ie?subject=Escala%20Network',monthly:{price:'€35',unit:'/ location / mo'},annual:{price:'€295',unit:'/ location / yr'},volume:['2 locations: €65/mo (bundle discount)','3–5 locations: €30/location/mo','6+ locations: Custom pricing — Contact us']},
];
---
<html lang="en" data-type="software" data-site-kind="software"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Escala builds café rosters in minutes. Stay on the right side of Irish law. From €19/month. 15-day free trial. Card required. Cancel anytime." /><title>Escala — café rosters done in minutes</title></head><body>
<header class="relative z-10"><nav class="container-shell flex items-center justify-between py-6" aria-label="Main navigation"><a href="#top" class="text-xl font-bold tracking-tight flex items-center gap-2">escala<svg width="18" height="20" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polygon points="24,4 41.32,14 41.32,34 24,44 6.68,34 6.68,14" fill="rgba(139,92,246,0.18)" stroke="#a78bfa" stroke-width="2.5" stroke-linejoin="round"/><polygon points="24,12 34.39,18 34.39,30 24,36 13.61,30 13.61,18" fill="none" stroke="rgba(167,139,250,0.45)" stroke-width="1" stroke-linejoin="round"/></svg></a><a href="#pricing" class="button-secondary !min-h-10 !px-4 text-sm">Start 15-day free trial</a></nav></header>
<main id="top">
<section class="relative isolate overflow-hidden pt-16 pb-24 md:pt-28 md:pb-32"><div class="hero-grid absolute inset-0 -z-10"></div><div class="hero-glow -z-10"></div><div class="container-shell grid items-center gap-14 lg:grid-cols-[1.02fr_.98fr]"><div class="reveal"><p class="eyebrow mb-6">Dublin cafés · 5–20 staff</p><h1 class="display-head text-5xl font-semibold md:text-7xl">Your roster done in minutes!</h1><p class="mt-7 max-w-xl text-lg leading-8 muted">Your cafe roster, done in clicks. Save hours every week — and stay on the right side of Irish law.</p><div class="mt-9 flex flex-col gap-3 sm:flex-row"><a class="button-primary" href="#pricing">Start 15-day free trial <span aria-hidden="true">↗</span></a><a class="button-secondary" href="#sample-week">See a sample Dublin week</a></div><p class="mt-4 max-w-lg text-sm leading-6 muted">Card required. Cancel anytime.</p></div><div id="sample-week" class="reveal hero-panel rounded-[22px] p-5 md:p-6"><div class="flex items-center justify-between border-b border-white/10 pb-4"><div><p class="mono text-xs text-violet-300">The Copper Kettle · week 42 · dublin 8</p><h2 class="mt-1.5 text-base font-semibold leading-tight">14–20 Oct · 5 staff · all legal</h2></div><span class="rounded-full bg-emerald-300/10 px-3 py-1 text-xs text-emerald-200">WRC-safe</span></div><div class="roster-wrap mt-3"><table class="roster-tbl"><thead><tr><th></th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th><th>Sun</th></tr></thead><tbody><tr><td class="staff-name">Aoife</td><td class="shift-open">Open<br/>08–16</td><td class="shift-open">Open<br/>08–16</td><td class="shift-off">—</td><td class="shift-open">Open<br/>08–16</td><td class="shift-open">Open<br/>08–16</td><td class="shift-off">—</td><td class="shift-close">Close<br/>14–22</td></tr><tr><td class="staff-name">Sam</td><td class="shift-off">—</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-off">—</td><td class="shift-close">Close<br/>14–22</td><td class="shift-off">—</td></tr><tr><td class="staff-name">Niamh</td><td class="shift-open">Open<br/>08–16</td><td class="shift-off">—</td><td class="shift-open">Open<br/>08–16</td><td class="shift-off">—</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-open">Open<br/>08–16</td></tr><tr><td class="staff-name">Ciarán</td><td class="shift-off">—</td><td class="shift-close">Close<br/>14–22</td><td class="shift-off">—</td><td class="shift-close">Close<br/>14–22</td><td class="shift-off">—</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-mid">Mid<br/>11–19</td></tr><tr><td class="staff-name">Roisín</td><td class="shift-mid">Mid<br/>11–19</td><td class="shift-off">—</td><td class="shift-close">Close<br/>14–22</td><td class="shift-off">—</td><td class="shift-close">Close<br/>14–22</td><td class="shift-open">Open<br/>08–16</td><td class="shift-off">—</td></tr></tbody></table></div><div class="mt-3 flex items-center justify-between text-xs muted border-t border-white/10 pt-3"><span>Generated in 8 seconds · 0 violations</span><span class="mono text-violet-300">export.pdf</span></div></div></div></section>
<section class="section section-rule py-12 md:py-16"><div class="container-shell grid gap-8 md:grid-cols-3"><div class="problem-item reveal"><span class="problem-icon">↗</span><div><h2 class="font-semibold">Clopening blocked automatically</h2><p class="mt-2 text-sm muted">No close-then-open surprises.</p></div></div><div class="problem-item reveal"><span class="problem-icon">◷</span><div><h2 class="font-semibold">11-hour rest enforced</h2><p class="mt-2 text-sm muted">Every gap checked before you post.</p></div></div><div class="problem-item reveal"><span class="problem-icon">◆</span><div><h2 class="font-semibold">Keyholder on every close</h2><p class="mt-2 text-sm muted">The right person is always there.</p></div></div></div></section>
<section class="section section-rule"><div class="container-shell"><div class="grid gap-8 md:grid-cols-[.8fr_1.2fr] md:items-end"><h2 class="display-head text-4xl font-semibold md:text-5xl reveal">Excel draws the grid. Escala checks the week.</h2><p class="max-w-lg leading-7 muted reveal">The difference is not another rota template. It is knowing the schedule is ready before it reaches the staff WhatsApp.</p></div><div class="comparison mt-14 reveal"><div class="comparison-row comparison-head"><div>Excel</div><div class="text-violet-300">Escala</div></div><div class="comparison-row"><div class="muted">Manual</div><div>Automatic</div></div><div class="comparison-row"><div class="muted">Error-prone</div><div>Legal &amp; compliant</div></div><div class="comparison-row"><div class="muted">No compliance check</div><div>Generates in minutes</div></div><div class="comparison-row"><div class="muted">Sunday nightmare</div><div>Legally defensible</div></div></div></div></section>
<section id="how-it-works" class="section section-rule"><div class="container-shell"><h2 class="display-head text-4xl font-semibold md:text-5xl reveal">From team list to posted roster.</h2><div class="mt-14 grid gap-px overflow-hidden rounded-[18px] border border-white/10 bg-white/10 md:grid-cols-3"><div class="bg-[var(--surface)] p-7 reveal"><p class="mono text-sm text-violet-300">01</p><h3 class="mt-12 text-2xl font-semibold">Add your team</h3><p class="mt-4 muted">Five minutes to set availability, roles, and keyholders.</p></div><div class="bg-[var(--surface)] p-7 reveal"><p class="mono text-sm text-violet-300">02</p><h3 class="mt-12 text-2xl font-semibold">Generate the week</h3><p class="mt-4 muted">Ten seconds to solve the shifts without gaps.</p></div><div class="bg-[var(--surface)] p-7 reveal"><p class="mono text-sm text-violet-300">03</p><h3 class="mt-12 text-2xl font-semibold">Export and post</h3><p class="mt-4 muted">Post a clean PDF or send the CSV to your team.</p></div></div></div></section>
<section class="section section-rule"><div class="container-shell"><div class="grid gap-4 md:grid-cols-3"><article class="feature-card reveal"><p class="mono text-sm text-violet-300">01</p><h2 class="mt-16 text-2xl font-semibold">11h rest and breaks, enforced</h2><p class="mt-4 leading-7 muted">Clopening blocked. Breaks scheduled. Keyholder on every close.</p></article><article class="feature-card reveal"><p class="mono text-sm text-violet-300">02</p><h2 class="mt-16 text-2xl font-semibold">Sunday night, reclaimed</h2><p class="mt-4 leading-7 muted">Team once. Legal week in minutes. Export and post.</p></article><article class="feature-card reveal"><p class="mono text-sm text-violet-300">03</p><h2 class="mt-16 text-2xl font-semibold">Café-simple, not HR-complex</h2><p class="mt-4 leading-7 muted">For owners and floor managers. No training course.</p></article></div></div></section>
<section id="pricing" class="section section-rule" data-billing="monthly"><div class="container-shell"><div class="reveal max-w-2xl"><h2 class="display-head text-4xl font-semibold md:text-5xl">Plans that fit your café.</h2><p class="mt-6 text-lg leading-8 muted">15-day free trial on Starter, Standard, and Pro. Card required. Cancel anytime.</p></div>
        <div class="billing-toggle reveal mt-10" role="group" aria-label="Billing period">
          <button type="button" class="billing-btn" data-billing-btn="monthly" aria-pressed="true">Monthly</button>
          <button type="button" class="billing-btn" data-billing-btn="annual" aria-pressed="false">Annual <span class="billing-save">2 months free</span></button>
        </div>
        <div class="price-grid mt-10">{plans.map((plan)=>(
          <article class:list={['price-card','reveal','p-6','md:p-7', plan.featured && 'price-card--featured']}>
            <p class="mono text-xs text-violet-300">{plan.name}{plan.featured ? ' · most cafés' : ''}</p>
            <p class="mt-4 text-4xl font-semibold price-monthly">{plan.monthly.price}<span class="text-base font-normal muted">{plan.monthly.unit}</span></p>
            <p class="mt-4 text-4xl font-semibold price-annual">{plan.annual.price}<span class="text-base font-normal muted">{plan.annual.unit}</span></p>
            {plan.annual.save ? <p class="price-annual mt-2 text-sm text-emerald-200">{plan.annual.save} · 2 months free</p> : null}
            <p class="mt-3 text-sm muted">{plan.detail}</p>
            {plan.volume ? (
              <ul class="volume-list mt-4 text-xs muted">
                {plan.volume.map((line)=>(<li>{line}</li>))}
              </ul>
            ) : null}
            {plan.selfServe ? <button type="button" class="button-primary mt-8 w-full" data-tier={plan.tier}>Start 15-day free trial <span aria-hidden="true">↗</span></button> : <a class="button-secondary mt-8 w-full" href="mailto:hello@madfrog.ie?subject=Escala%20Network">Talk to us</a>}
            <p class="mt-4 text-center text-xs muted">No setup fee. Cancel anytime.</p>
            {plan.selfServe ? <p class="price-monthly mt-1 text-center text-xs muted">Card required. Cancel anytime.</p> : null}
            <p class="price-annual mt-1 text-center text-xs muted">2 months free. Billed annually.</p>
          </article>
        ))}</div></div></section>
<section class="section section-rule"><div class="container-shell grid gap-12 md:grid-cols-[.75fr_1.25fr]"><h2 class="display-head text-4xl font-semibold md:text-5xl reveal">Questions owners ask on Sunday night.</h2><div class="reveal">{faqs.map(([question,answer])=><div class="faq-item" data-open="false"><button class="faq-button" type="button" aria-expanded="false"><span>{question}</span><span class="faq-icon" aria-hidden="true">+</span></button><div class="faq-answer"><div><p class="pb-5 pr-8 leading-7 muted">{answer}</p></div></div></div>)}</div></div></section>
</main><footer class="section section-rule !pb-10"><div class="container-shell flex flex-col gap-8 md:flex-row md:items-end md:justify-between"><div><a href="#top" class="text-xl font-bold tracking-tight flex items-center gap-2">escala<svg width="18" height="20" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polygon points="24,4 41.32,14 41.32,34 24,44 6.68,34 6.68,14" fill="rgba(139,92,246,0.18)" stroke="#a78bfa" stroke-width="2.5" stroke-linejoin="round"/><polygon points="24,12 34.39,18 34.39,30 24,36 13.61,30 13.61,18" fill="none" stroke="rgba(167,139,250,0.45)" stroke-width="1" stroke-linejoin="round"/></svg></a><p class="mt-4 text-sm muted">Built in Dublin by Mad Frog Studio · <a class="underline decoration-white/20 underline-offset-4" href="https://madfrog.ie">madfrog.ie</a></p></div><div class="text-sm md:text-right"><a class="underline decoration-white/20 underline-offset-4" href="mailto:hello@madfrog.ie">hello@madfrog.ie</a><p class="mt-3 text-xs muted">© 2026 Mad Frog Studio</p></div></div></footer>
<div id="checkout-modal" hidden style="position:fixed;inset:0;z-index:50;background:rgba(10,10,15,.82);padding:20px;display:grid;place-items:center">
  <div role="dialog" aria-modal="true" aria-labelledby="checkout-title" style="width:min(100%,480px);background:#0d0a1a;border:1px solid rgba(167,139,250,.55);border-radius:18px;padding:28px;box-shadow:0 28px 90px rgba(0,0,0,.55)">
    <button type="button" id="checkout-close" aria-label="Close" style="float:right;border:0;background:none;color:#a78bfa;font-size:28px;line-height:1;cursor:pointer">×</button>
    <h2 id="checkout-title" style="color:#f6f4ff;font-size:28px;margin:0 0 8px">Start your 15-day trial</h2>
    <p style="color:#b8b0ce;margin:0 0 24px">Tell us where to send your login details.</p>
    <form id="checkout-form">
      <label for="checkout-cafe-name" style="display:block;color:#f6f4ff;font-size:14px;margin-bottom:8px">Your café name</label>
      <input id="checkout-cafe-name" name="cafe_name" type="text" placeholder="Your café name" maxlength="60" required style="width:100%;box-sizing:border-box;background:#151025;color:#f6f4ff;border:1px solid rgba(255,255,255,.16);border-radius:10px;padding:12px 14px;margin-bottom:16px" />
      <input id="checkout-tier" name="tier" type="hidden" />
      <input id="checkout-interval" name="interval" type="hidden" />
      <button id="checkout-submit" type="submit" class="button-primary w-full">Start my free trial →</button>
      <p style="color:#888;font-size:12px;text-align:center;margin:12px 0 0">Card required. Cancel anytime.</p>
      <p id="checkout-error" role="alert" hidden style="color:#fca5a5;font-size:13px;margin:14px 0 0"></p>
    </form>
  </div>
</div>
<script>
import { animate, inView } from 'motion';
document.querySelectorAll('.reveal').forEach((el,i)=>inView(el,()=>animate(el,{opacity:[0,1],transform:['translateY(20px)','translateY(0)']},{duration:.65,delay:Math.min(i*.04,.22),easing:[.22,1,.36,1]})));
document.querySelectorAll('.faq-button').forEach(button=>button.addEventListener('click',()=>{const item=button.closest('.faq-item');const open=item.dataset.open==='true';document.querySelectorAll('.faq-item').forEach(other=>{other.dataset.open='false';other.querySelector('.faq-button').setAttribute('aria-expanded','false')});item.dataset.open=String(!open);button.setAttribute('aria-expanded',String(!open));}));
const pricing=document.getElementById('pricing');
document.querySelectorAll('[data-billing-btn]').forEach(btn=>btn.addEventListener('click',()=>{const period=btn.getAttribute('data-billing-btn');pricing.dataset.billing=period;document.querySelectorAll('[data-billing-btn]').forEach(other=>{other.setAttribute('aria-pressed',String(other===btn));});}));
const modal=document.getElementById('checkout-modal');
const checkoutForm=document.getElementById('checkout-form');
const cafeNameInput=document.getElementById('checkout-cafe-name');
const tierInput=document.getElementById('checkout-tier');
const intervalInput=document.getElementById('checkout-interval');
const submitButton=document.getElementById('checkout-submit');
const errorMessage=document.getElementById('checkout-error');
const openModal=(tier)=>{tierInput.value=tier;intervalInput.value=pricing?.dataset.billing==='annual'?'year':'month';errorMessage.hidden=true;errorMessage.textContent='';modal.hidden=false;cafeNameInput.focus();};
document.querySelectorAll('[data-tier]').forEach(button=>button.addEventListener('click',()=>openModal(button.dataset.tier)));
const closeModal=()=>{modal.hidden=true;};
document.getElementById('checkout-close').addEventListener('click',closeModal);
modal.addEventListener('click',(event)=>{if(event.target===modal)closeModal();});
checkoutForm.addEventListener('submit',async(event)=>{event.preventDefault();errorMessage.hidden=true;submitButton.disabled=true;submitButton.textContent='Opening checkout…';try{const response=await fetch('https://nbggytkbrxqhnqvtvbpl.supabase.co/functions/v1/create-checkout',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({cafe_name:cafeNameInput.value.trim(),tier:tierInput.value,interval:intervalInput.value})});const data=await response.json();if(!response.ok||!data.url)throw new Error(data.error||'Could not create checkout.');window.location.href=data.url;}catch(error){errorMessage.textContent=error.message||'Could not create checkout. Please try again.';errorMessage.hidden=false;submitButton.disabled=false;submitButton.textContent='Start my free trial →';}});
</script></body></html>
